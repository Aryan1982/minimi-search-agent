{
  "name": "minimi-search-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A chat agent with one tool, web search, and dated memory of past conversations.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "tsx watch src/server.ts",
    "prestart": "node scripts/check-node.mjs",
    "start": "tsx src/server.ts",
    "pretest": "node scripts/check-node.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preseed": "node scripts/check-node.mjs",
    "seed": "tsx scripts/seed.ts",
    "preimport": "node scripts/check-node.mjs",
    "import": "tsx scripts/import.ts",
    "preeval": "node scripts/check-node.mjs",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "chrono-node": "^2.10.3",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
